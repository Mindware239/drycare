{
  "name": "drycare",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DryCare — Multi-tenant Dry Cleaning & Laundry Management SaaS",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @drycare/api db:generate",
    "db:migrate": "pnpm --filter @drycare/api db:migrate",
    "db:seed": "pnpm --filter @drycare/api db:seed",
    "admin:create": "pnpm --filter @drycare/api admin:create",
    "email:check": "pnpm --filter @drycare/api email:check --",
    "dev:api": "pnpm --filter @drycare/api dev",
    "dev:web": "pnpm --filter @drycare/web dev",
    "dev:worker": "pnpm --filter @drycare/api worker",
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "test": "pnpm --filter @drycare/shared test",
    "smoke": "pnpm --filter @drycare/api smoke",
    "backup-test": "pnpm --filter @drycare/api backup-test",
    "license:keygen": "pnpm --filter @drycare/api exec tsx ../../scripts/license-issuer.ts keygen",
    "license:issue": "pnpm --filter @drycare/api exec tsx ../../scripts/license-issuer.ts issue",
    "typecheck": "pnpm -r typecheck && pnpm --filter @drycare/api exec tsc --noEmit -p ../../tsconfig.json",
    "flow-test": "pnpm --filter @drycare/api flow-test",
    "laundry-test": "pnpm --filter @drycare/api laundry-test",
    "billing-test": "pnpm --filter @drycare/api billing-test",
    "license-test": "pnpm --filter @drycare/api license-test",
    "reports-test": "pnpm --filter @drycare/api reports-test",
    "wallet-test": "pnpm --filter @drycare/api wallet-test",
    "inventory-test": "pnpm --filter @drycare/api inventory-test",
    "sync-test": "pnpm --filter @drycare/api sync-test",
    "cloud-sync-test": "pnpm --filter @drycare/api cloud-sync-test",
    "desktop:startup-test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-startup-test.ps1",
    "demo-test": "pnpm --filter @drycare/api demo-test",
    "demo-lock-test": "pnpm --filter @drycare/api demo-lock-test",
    "laundry-iot-sim": "pnpm --filter @drycare/api laundry-iot-sim"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "postgres": "3.4.9"
  }
}
