{
  "name": "@drycare/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx --env-file=../../.env src/server.ts",
    "worker": "tsx --env-file=../../.env src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file=../../.env src/db/seed.ts",
    "admin:create": "tsx --env-file=../../.env src/platform-admin-bootstrap.ts",
    "email:check": "tsx --env-file=../../.env src/check-email.ts",
    "smoke": "tsx --env-file=../../.env ../../scripts/smoke.ts",
    "backup-test": "tsx --env-file=../../.env ../../scripts/backup-test.ts",
    "typecheck": "tsc --noEmit",
    "flow-test": "tsx --env-file=../../.env ../../scripts/garment-flow.ts",
    "laundry-test": "tsx --env-file=../../.env ../../scripts/laundry-flow.ts",
    "billing-test": "tsx --env-file=../../.env ../../scripts/billing-flow.ts",
    "license-test": "tsx --env-file=../../.env ../../scripts/license-flow.ts",
    "reports-test": "tsx --env-file=../../.env ../../scripts/reports-flow.ts",
    "wallet-test": "tsx --env-file=../../.env ../../scripts/wallet-flow.ts",
    "inventory-test": "tsx --env-file=../../.env ../../scripts/inventory-claims-flow.ts",
    "sync-test": "tsx --env-file=../../.env ../../scripts/sync-queue-test.ts",
    "cloud-sync-test": "tsx --env-file=../../.env ../../scripts/cloud-sync-test.ts",
    "demo-test": "tsx --env-file=../../.env ../../scripts/demo-check.ts",
    "demo-lock-test": "tsx --env-file=../../.env ../../scripts/demo-lock-check.ts",
    "laundry-iot-sim": "tsx --env-file=../../.env ../../scripts/laundry-iot-simulator.ts"
  },
  "dependencies": {
    "@drycare/shared": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.5",
    "@node-rs/argon2": "2.2.2",
    "bwip-js": "4.11.4",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nodemailer": "6.9.16",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/nodemailer": "6.4.17",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
